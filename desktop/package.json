{
  "name": "flacplayer-desktop",
  "version": "1.0.0",
  "description": "FlacPlayer — Monochrome Hi-Res Lossless Audio Player",
  "homepage": "https://github.com/axalotus/flacplayer",
  "main": "main.js",
  "author": "Antigravity AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz",
    "dist:win": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.antigravity.flacplayer.desktop",
    "productName": "FlacPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "maintainer": "FlacPlayer <axalotus@github.com>",
      "artifactName": "FlacPlayer-${version}-Linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "FlacPlayer-${version}-Windows-x64-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlacPlayer",
      "artifactName": "FlacPlayer-${version}-Windows-x64-Setup.exe"
    }
  },
  "dependencies": {
    "music-metadata": "^10.6.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
