{
  "name": "zuna-desktop",
  "version": "1.1.0",
  "description": "Zuna — Monochrome Hi-Res Lossless Audio Player",
  "homepage": "https://github.com/axalotus/zuna-player",
  "main": "main.js",
  "author": "Antigravity AI",
  "license": "MIT",
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz",
    "dist:win": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.zuna.player.desktop",
    "productName": "Zuna",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "build/Release/*.node"
    ],
    "asarUnpack": [
      "build/Release/*.node"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "maintainer": "Zuna <axalotus@github.com>",
      "artifactName": "Zuna-${version}-Linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "Zuna-${version}-Windows-x64-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zuna",
      "artifactName": "Zuna-${version}-Windows-x64-Setup.exe"
    }
  },
  "dependencies": {
    "music-metadata": "^10.6.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
